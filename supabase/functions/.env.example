# Custom Edge Function settings only. Supabase injects its own SUPABASE_* values.
# Copy to .env for local use. Set production secrets separately.
# Application and storage (bucket names do not create buckets)
APP_NAME=LoreMore
APP_ENV=development
LOREMORE_MOMENTS_BUCKET=moments
LOREMORE_PROFILE_BUCKET=profile-media

# AI — server only; set model IDs when implementing each feature
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=

# LoreCall — optional until a provider is selected
VOICE_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VAPI_API_KEY=
RETELL_API_KEY=

# Website — public values
PUBLIC_SITE_URL=
WEB_APP_URL=http://localhost:3000

# Server only — each webhook handler must verify its configured secret
APP_SECRET=
LOREMORE_SUPABASE_WEBHOOK_SECRET=
LOREMORE_WEBHOOK_SECRET=
