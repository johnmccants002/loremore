# Expo client values — these are embedded in the app and must be public.
EXPO_PUBLIC_SUPABASE_URL=https://mkfkevnncrxmtnbgwzup.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy client key alternative.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Local server/tooling configuration. NEVER bundle this file in iOS.
SUPABASE_URL=https://mkfkevnncrxmtnbgwzup.supabase.co
# Preferred client key; copy from the project's API Keys settings.
SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative, only if the integration requires it.
SUPABASE_ANON_KEY=
# Server only; fill only if an admin operation actually needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Set after selecting your Apple developer bundle identifiers.
IOS_BUNDLE_ID=
SHARE_EXTENSION_BUNDLE_ID=

# Application and storage (bucket names do not create buckets)
APP_NAME=LoreMore
APP_ENV=development
LOREMORE_MOMENTS_BUCKET=moments
LOREMORE_PROFILE_BUCKET=profile-media

# AI — server only; set model IDs when implementing each feature
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=

# LoreCall — optional until a provider is selected
VOICE_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VAPI_API_KEY=
RETELL_API_KEY=

# Website — public values
PUBLIC_SITE_URL=
WEB_APP_URL=http://localhost:3000

# Server only — each webhook handler must verify its configured secret
APP_SECRET=
LOREMORE_SUPABASE_WEBHOOK_SECRET=
LOREMORE_WEBHOOK_SECRET=

# Optional iOS App Group override; defaults to group.<IOS_BUNDLE_ID>.shared
IOS_APP_GROUP_ID=
